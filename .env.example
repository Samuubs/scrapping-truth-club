# Copie para .env e preencha (Painel do Supabase > Project Settings > API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave secreta: use apenas no scraper, nunca no app
SUPABASE_SERVICE_ROLE_KEY=

# ---- Comentários gerados por IA (obrigatório: configure ao menos um provedor) ----
# Preencha a chave de quantos provedores quiser. Se um falhar (limite de tokens/requisições,
# chave inválida etc.), o próximo da cadeia é usado automaticamente.

# Ordem da cadeia (opcional). Padrão: personalizado,gemini,groq,github,openrouter
# (só entram os que têm chave). O ollama só é usado se for listado aqui.
# AI_PROVEDORES=groq,gemini,github,openrouter,ollama

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# GitHub Models: token pessoal com a permissão "models:read"
GH_MODELS_TOKEN=
# GH_MODELS=openai/gpt-4.1-mini

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free

# Ollama (local, sem chave)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODELS=llama3.2

# Provedor personalizado (qualquer API compatível com a da OpenAI); fica em 1º lugar na ordem padrão
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=

# Pausa entre uma consulta à IA e outra, em ms
AI_INTERVALO_MS=1000
# Tempo máximo total, em ms, da comparação de notícias repetidas por IA em cada execução
AI_COMPARACAO_MAX_MS=300000
